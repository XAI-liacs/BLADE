# Episode 7: BLADE with a coding agent - scene 2 only.
# The agent session (scenes 3 to 5) is a screen recording.

Output episode.mp4

Set Shell "bash"
Set FontSize 22
Set Width 1920
Set Height 1080
Set Padding 40
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms

Type "uv run iohblade skill"
Enter
Sleep 5s
Type "head -20 .claude/skills/blade/SKILL.md"
Enter
Sleep 8s
